{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  platformAutomerge: false,
  rebaseWhen: "conflicted",
  // flake.lock は .github/workflows/flake-update.yml が毎朝更新する。Renovate からも
  // lock の PR が来ると衝突するので、ここでは nix を扱わない。
  nix: {
    enabled: false,
  },
  // go.sum に古い版の行を残さない。
  postUpdateOptions: ["gomodTidy"],
  // .github/workflows/rat-vendor-hash.yml が Go の PR に vendorHash を追いコミットする。
  // その author を無視しないと、Renovate は branch を人が触ったものとみなして rebase をやめる。
  gitIgnoredAuthors: ["41898282+github-actions[bot]@users.noreply.github.com"],
}
