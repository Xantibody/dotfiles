{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":semanticCommitTypeAll(chore)"],

  // The Mend app installed on all repositories starts silent (dryRun=lookup)
  // and opens neither PRs nor the dependency dashboard; this undoes that.
  mode: "full",

  timezone: "Asia/Tokyo",
  schedule: ["before 6am on monday"],
  labels: ["dependencies"],

  // The nix manager is beta and off by default; it is what tracks flake.lock.
  nix: { enabled: true },

  packageRules: [
    {
      description: "Flake inputs follow branches, so each one is a digest bump every week; one PR for all.",
      matchManagers: ["nix"],
      groupName: "flake inputs",
    },
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
  ],
}
