{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "language": "japanese",
  "ultracode": true,
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Grep",
      "Glob",
      "Workflow",
      "Bash(cargo *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(mkdir *)",
      "Bash(rtk cargo *)",
      "Bash(rtk git add *)",
      "Bash(rtk git commit *)",
      "mcp__plugin_mcp-defaults_ck",
      "mcp__plugin_mcp-defaults_codegraph"
    ],
    "ask": [
      "Edit(**/justfile)",
      "Edit(**/Justfile)",
      "Edit(**/.justfile)",
      "Edit(**/*.just)",
      "Edit(**/.github/workflows/**)",
      "Edit(**/.github/zizmor.yml)",
      "Edit(**/.claude/settings*.json)",
      "Edit(**/tsconfig*.json)",
      "Edit(**/eslint.config.*)",
      "Edit(**/.eslintrc*)",
      "Edit(**/eslint-suppressions.json)",
      "Edit(**/.oxlintrc.json)",
      "Edit(**/oxlint.config.*)",
      "Edit(**/oxlint-suppressions.json)",
      "Edit(**/biome.json)",
      "Edit(**/biome.jsonc)",
      "Edit(**/.tsc-baseline)",
      "Edit(**/vitest.config.*)",
      "Edit(**/vitest.workspace.*)",
      "Edit(**/playwright.config.*)",
      "Edit(**/.golangci.*)",
      "Edit(**/clippy.toml)",
      "Edit(**/.clippy.toml)",
      "Edit(**/deny.toml)",
      "Edit(**/rustfmt.toml)",
      "Edit(**/.rustfmt.toml)",
      "Edit(**/.config/nextest.toml)",
      "Edit(**/statix.toml)",
      "Edit(**/typos.toml)",
      "Edit(**/_typos.toml)",
      "Edit(**/.typos.toml)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(curl *)",
      "Bash(curl)",
      "Bash(sleep *)",
      "Bash(sleep)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "rat hook deny"
          },
          {
            "type": "command",
            "command": "gh-guard"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "anchors-hook"
          }
        ]
      }
    ]
  },
  "plansDirectory": ".ai/plans",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "CLAUDE_CODE_HIDE_ACCOUNT_INFO": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_BUG_COMMAND": "1"
  }
}
