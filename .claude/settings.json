{
  "permissions": {
    "deny": [
      "Bash(nix flake check*)",
      "Bash(darwin-rebuild build*)",
      "Bash(nix eval .#*Configurations*)",
      "Bash(nix build .#checks*eval-*)",
      "Bash(verify-gate run *nix flake check*)",
      "Bash(verify-gate run *darwin-rebuild build*)",
      "Bash(verify-gate run *nix eval .#*Configurations*)",
      "Bash(verify-gate run *nix build .#checks*eval-*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v flock >/dev/null; then exec flock \"${TMPDIR:-/tmp}/dotfiles-nix-fmt.lock\" nix fmt; else echo 'nix fmt hook: flock is not on PATH (devShell not loaded), formatting without the lock' >&2; exec nix fmt; fi"
          }
        ]
      }
    ]
  }
}
